<!DOCTYPE html>
<html>
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
  <%- include('partials/navbar') %>

  <div class="max-w-6xl mx-auto py-10 px-4">

    <h1 class="text-4xl font-bold text-center mb-6">Gallery</h1>

    <form method="GET" action="/gallery" class="flex justify-center mb-6">
      <input name="search" value="<%= search %>" class="px-4 py-2 border rounded w-full max-w-md" placeholder="Search..." />
      <button class="ml-2 bg-gray-800 text-white px-4 rounded">Search</button>
    </form>

    <div class="flex justify-center gap-3 mb-6">
      <a href="/gallery" class="px-4 py-2 border rounded <%= !category ? 'bg-gray-900 text-white' : '' %>">All</a>
      <a href="/gallery?category=nature" class="px-4 py-2 border rounded <%= category==='nature' ? 'bg-gray-900 text-white' : '' %>">Nature</a>
      <a href="/gallery?category=city" class="px-4 py-2 border rounded <%= category==='city' ? 'bg-gray-900 text-white' : '' %>">City</a>
    </div>

    <% if (gallery.length === 0) { %>
      <p class="text-center text-gray-500">No images found.</p>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% gallery.forEach(item => { %>
        <a href="/gallery/<%= item.id %>" class="bg-white shadow rounded overflow-hidden">
          <img src="<%= item.image %>" class="h-48 w-full object-cover" />
          <div class="p-4">
            <h2 class="font-bold"><%= item.title %></h2>
            <p class="text-sm text-gray-500"><%= item.category %></p>
          </div>
        </a>
      <% }) %>
    </div>

  </div>

  <%- include('partials/footer') %>
</body>
</html>
